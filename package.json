{
  "name": "facet-api-reference",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Documentação OpenAPI privada com administração de acesso.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include .env --env-file-if-exists=.env server/index.ts",
    "build": "npm run check && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env build/server/index.js",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "npm run build && playwright test",
    "migrate:sqlite": "node --env-file-if-exists=.env build/server/migrate-sqlite.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "lucide": "^1.60.0",
    "lucide-react": "^1.60.0",
    "markdown-it": "^15.0.3",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
