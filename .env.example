# Required. Set a private password of 15 to 128 characters.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

HOST=127.0.0.1
PORT=4173
# PostgreSQL credentials used to initialize the local Compose database.
POSTGRES_DB=facet
POSTGRES_USER=facet
POSTGRES_PASSWORD=
# Required. Use host postgres in Compose; 127.0.0.1 for PostgreSQL on your host.
# Fill the same database/user/password above; URL-encode the password in the URI.
# Example structure: postgresql://facet:<encoded-password>@postgres:5432/facet
DATABASE_URL=
# Required for mandatory authenticator-app MFA enrollment.
# Generate once: openssl rand -base64 32
# Keep a secure backup together with the database; do not rotate without migration.
MFA_ENCRYPTION_KEY=
# Compose defaults to development over local HTTP, running the compiled app.
# Set NODE_ENV=production only behind an HTTPS reverse proxy.
# NODE_ENV=production
# Automatic: true with NODE_ENV=production, false for local HTTP.
# Production refuses false. Optional explicit setting:
# COOKIE_SECURE=true
# Set true only behind one trusted reverse proxy; block direct public access.
TRUST_PROXY=false
